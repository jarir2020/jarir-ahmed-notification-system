{
    "name": "jarir-ahmed/notification-system",
    "description": "A simple notification system to display messages on the front end.",
    "type": "library",
    "license": "MIT",
    "keywords": ["notification", "flash", "alert", "yii2"],
    "authors": [
        {
            "name": "Jarir Ahmed",
            "email": "jarircse16@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "JarirAhmed\\NotificationSystem\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JarirAhmed\\NotificationSystem\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=7.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "suggest": {
        "yiisoft/yii2": "Required only for the Yii NotificationHelper / AssetBundle integration"
    },
    "scripts": {
        "test": "phpunit"
    }
}
